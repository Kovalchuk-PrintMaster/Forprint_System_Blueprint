# ForPrint module coordination record targets.

Expected variable:
PYTHON

.PHONY: coordination-records-refresh
coordination-records-refresh:
	$(PYTHON) scripts/update_module_coordination_records.py

.PHONY: coordination-records-check
coordination-records-check:
	$(PYTHON) scripts/check_module_coordination_records.py

.PHONY: prompt-completion-apply
prompt-completion-apply:
	test -n "$(REPORT)" || (echo "REPORT=<path> is required" && exit 1)
	$(PYTHON) scripts/validate_prompt_completion_report.py "$(REPORT)"
	$(PYTHON) scripts/apply_prompt_completion_report.py "$(REPORT)" --write

.PHONY: prompt-completion-check
prompt-completion-check:
	test -n "$(REPORT)" || (echo "REPORT=<path> is required" && exit 1)
	$(PYTHON) scripts/validate_prompt_completion_report.py "$(REPORT)"
	$(PYTHON) scripts/check_module_coordination_records.py
