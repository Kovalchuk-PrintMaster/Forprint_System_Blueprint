# ForPrint module .env.example
#
# Copy this file to .env for local development.
# Do not commit real .env files.
# Leave values empty unless the value is clearly fake and safe.

# Runtime environment
FORPRINT_ENV=local

# Database / storage
DATABASE_URL=

# Integration Gateway
INTEGRATION_GATEWAY_BASE_URL=

# Channel tokens
TELEGRAM_BOT_TOKEN=
VIBER_AUTH_TOKEN=

# Email / SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# 1C / accounting sandbox
ONE_C_BASE_URL=
ONE_C_USERNAME=
ONE_C_PASSWORD=

# Production guard
PRODUCTION_WRITE_ENABLED=false
